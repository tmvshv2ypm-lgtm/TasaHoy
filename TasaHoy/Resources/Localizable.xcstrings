    "settings.disclaimer_body": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy es una herramienta informativa independiente, sin anuncios ni afiliación gubernamental o con exchanges. La única tasa oficial en Venezuela es la publicada por el Banco Central de Venezuela (bcv.org.ve). La referencia USDT se calcula en vivo a partir de anuncios públicos de compra y venta en Binance P2P (1 USDT ≠ 1 USD) y varía según la dinámica del mercado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy is an independent, ad-free informational utility with no government or exchange affiliation. The only official exchange rate in Venezuela is published by the Central Bank of Venezuela (bcv.org.ve). The USDT reference is calculated live from public buy and sell offers on Binance P2P (1 USDT ≠ 1 USD) and fluctuates with market conditions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy é uma ferramenta informativa independente e sem anúncios. A única taxa oficial na Venezuela é a do Banco Central da Venezuela (bcv.org.ve). A referência USDT é calculada ao vivo a partir do Binance P2P (1 USDT ≠ 1 USD)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy est un outil informatif indépendant et sans publicité. Le seul taux officiel au Venezuela est celui de la Banque centrale (bcv.org.ve). La référence USDT provient en direct de Binance P2P (1 USDT ≠ 1 USD)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy ist ein unabhängiges, werbefreies Informationstool. Der einzige offizielle Kurs Venezuelas stammt von der BCV (bcv.org.ve). Der USDT-Referenzwert wird live aus öffentlichen Binance P2P-Angeboten berechnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy è uno strumento informativo indipendente e senza pubblicità. L'unico tasso ufficiale in Venezuela è quello della BCV (bcv.org.ve). Il riferimento USDT è calcolato dal vivo su Binance P2P."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy — независимый справочный инструмент без рекламы. Единственный официальный курс в Венесуэле публикуется Центробанком (bcv.org.ve). Курс USDT рассчитывается онлайн по открытым ордерам Binance P2P."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TasaHoy 是一款独立、无广告的汇率参考工具。委内瑞拉唯一官方汇率由委内瑞拉中央银行 (bcv.org.ve) 发布；USDT 参考价根据币安 P2P 公开买卖挂单实时计算（1 USDT ≠ 1 USD）。"
          }
        }
      }
    },
